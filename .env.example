# ---------------------------------------------------------------------------
# 3B Charpente : variables d'environnement
# Copier en .env.local pour travailler en local (jamais commité).
# Sur Vercel : Settings → Environment Variables (valeurs de type « Sensitive »).
# ---------------------------------------------------------------------------

# --- Obligatoires -----------------------------------------------------------

# Postgres (Neon). Sur Vercel, l'intégration Neon (Storage → Create Database →
# Neon) crée POSTGRES_URL, lue en priorité. Sinon : DATABASE_URL.
# Utiliser l'adresse « pooled » (…-pooler…) et sslmode=verify-full.
POSTGRES_URL=
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=verify-full

# Clé de chiffrement des sessions de l'administration (48 caractères aléatoires).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PAYLOAD_SECRET=

# --- Photos (Vercel Blob) ---------------------------------------------------

# Ajoutée automatiquement par Vercel quand un stockage Blob est relié au projet
# (Storage → Create → Blob → Connect). Sans elle, les photos restent en local (dev).
BLOB_READ_WRITE_TOKEN=

# --- Adresses ---------------------------------------------------------------

# Domaine canonique : sert aux balises canonical, au sitemap, aux données
# structurées. Toute autre adresse (aperçus, *.vercel.app) est en noindex.
NEXT_PUBLIC_SITE_URL=https://3bcharpente.fr

# Adresse de l'administration. Laisser vide sur Vercel (détectée seule).
# En local : http://localhost:3000
NEXT_PUBLIC_SERVER_URL=

# --- E-mails (Resend) -------------------------------------------------------

# Sans clé : les demandes de devis sont enregistrées dans l'administration
# (Demandes reçues), mais aucun e-mail n'est envoyé.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=site@3bcharpente.fr
EMAIL_FROM_NAME=3B Charpente (site internet)

# --- Premier import du contenu ----------------------------------------------

# Mots de passe des comptes créés au premier import (une seule fois ; à changer
# ensuite dans Administration → Utilisateurs).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_EDITOR_PASSWORD=

# --- Sauvegardes ------------------------------------------------------------

# Protège la route /site-api/backup appelée chaque nuit par Vercel Cron.
CRON_SECRET=

# --- Développement uniquement ----------------------------------------------

# true = Payload applique le schéma sans migration (prototypage local seulement).
PAYLOAD_DB_PUSH=false
